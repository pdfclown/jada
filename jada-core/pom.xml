        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <!--
            (jada-core:test-jar) Shared test model artifact generation.
          -->
          <execution>
            <id>core-test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
