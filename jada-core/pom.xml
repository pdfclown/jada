  <artifactId>jada-core</artifactId>

  <name>${project.artifactId}</name>
  <description>Core module of Jada, an extensible Javadoc doclet enabling users to combine an
arbitrary doclet with multiple pre- and post-processors in order to transform its output in more
flexible and convenient ways.</description>
  <url>${projectRootUrl}</url>

  <properties>
    <!--
      OVERRIDDEN PROPERTIES
    -->
    <projectJpmsName>org.pdfclown.jada.core</projectJpmsName>
    <rootdir>${project.basedir}/..</rootdir>

    <!--
      VERSIONS
    -->
    <closure-compiler.version>v20251216</closure-compiler.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
