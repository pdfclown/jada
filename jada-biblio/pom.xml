<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.pdfclown</groupId>
    <artifactId>jada-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../jada-parent/pom.xml</relativePath>
  </parent>

  <artifactId>jada-biblio</artifactId>

  <name>${project.artifactId}</name>
  <description>JadaBiblio is a Jada doclet extension to add bibliographies to Javadoc</description>
  <url>${projectRootUrl}</url>

  <properties>
    <!--
      OVERRIDDEN PROPERTIES
    -->
    <projectJpmsName>org.pdfclown.jada.biblio</projectJpmsName>
    <rootdir>${project.basedir}/..</rootdir>

    <!--
      VERSIONS
    -->
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.pdfclown</groupId>
      <artifactId>jada-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pdfclown</groupId>
      <artifactId>pdfclown-common-util</artifactId>
    </dependency>

    <!--
      TESTING
    -->
    <dependency>
      <groupId>org.pdfclown</groupId>
      <artifactId>jada-build</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pdfclown</groupId>
      <artifactId>jada-core</artifactId>
      <type>test-jar</type>
    </dependency>
  </dependencies>
</project>
